# Copy to .env and fill in. Any OpenAI-compatible endpoint works.

# --- OpenAI
# INVOICE_LLM_BASE_URL=https://api.openai.com/v1
# INVOICE_LLM_API_KEY=your-key-here
# INVOICE_LLM_MODEL=gpt-4o-mini

# --- Ollama (local, no key needed)
# INVOICE_LLM_BASE_URL=http://localhost:11434/v1
# INVOICE_LLM_MODEL=qwen2.5:7b
# INVOICE_LLM_VISION_MODEL=llama3.2-vision

# --- OpenRouter
# INVOICE_LLM_BASE_URL=https://openrouter.ai/api/v1
# INVOICE_LLM_API_KEY=your-key-here
# INVOICE_LLM_MODEL=provider/model-name

# --- vLLM / LM Studio / llama.cpp server
# INVOICE_LLM_BASE_URL=http://localhost:8000/v1
# INVOICE_LLM_MODEL=your-served-model

INVOICE_LLM_BASE_URL=
INVOICE_LLM_API_KEY=
INVOICE_LLM_MODEL=
INVOICE_LLM_VISION_MODEL=

# Optional tuning
# INVOICE_LLM_JSON_MODE=true
# INVOICE_LLM_TIMEOUT=120
# INVOICE_LLM_MAX_RETRIES=2
# INVOICE_MAX_ATTEMPTS=3
# INVOICE_TOLERANCE=0.01
# INVOICE_MAX_PAGES=5
# INVOICE_MIN_TEXT_CHARS=40
# INVOICE_IMAGE_DPI=150

# API service
# INVOICE_API_TOKEN=change-me
# INVOICE_MAX_UPLOAD_MB=15
